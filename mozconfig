# Make 64-bit build
ac_add_options --host=x86_64-pc-windows-msvc
ac_add_options --target=x86_64-pc-windows-msvc

# Set branding folder (/src/browser/branding/official/) and Distribution ID
ac_add_options --enable-official-branding
ac_add_options --with-distribution-id=nehochun.github.io

# Disable debug mode and assertions
ac_add_options --disable-debug

# Disable debug symbols
ac_add_options --disable-debug-symbols

# Disable building test libraries and programs
ac_add_options --disable-tests

# Enables default compiler optimization options
ac_add_options --enable-optimize

# Set telemetry option to "false" ("toolkit.telemetry.enabled" is locked to "true" on beta, aurora, nightly and default channels)
ac_add_options --enable-update-channel=release

# Enable sideloading extension support from "/browser/extensions/" folder
ac_add_options --allow-addon-sideload

# Allow unsigned add-ons in app and system scopes
ac_add_options --with-unsigned-addon-scopes=app,system

# Disable telemetry reporting
ac_add_options MOZ_TELEMETRY_REPORTING=

# Disable default browser agent
ac_add_options --disable-default-browser-agent

# Disable Firefox updater application
ac_add_options --disable-updater

# Disable crash reporter application
ac_add_options --disable-crashreporter

# Disable parental controls
ac_add_options --disable-parental-controls

# Disable Microsoft Background Intelligent Transfer Service
ac_add_options --disable-bits-download

# Disable WebDriver remote protocols
ac_add_options --disable-webdriver

# Disable scanning for global plugins such as Java and RealPlayer [WINDOWS]
ac_add_options --disable-system-extension-dirs

# Disable reading system policies from the Windows registry
ac_add_options --disable-system-policies

# Disable Mozilla Location Service Wi-Fi scanning
ac_add_options --disable-necko-wifi

# Disable WebRTC (Real-Time Communications)
ac_add_options --disable-webrtc

# Disable Encrypted Media Extensions (DRM)
ac_add_options --disable-eme
